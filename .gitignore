# the compiled kernel
/self

# an instance's DERIVED state — rebuilt by `self rehydrate` from the log alone
**/cap/

# an instance's SOURCE state — never commit these. .secret is the signing key;
# events.jsonl is a live log. Running `self` here would create them right beside
# the code, and one `git add .` would publish your key. Guard against that.
.secret
events.jsonl
.self/

__pycache__/
