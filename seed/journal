#!/usr/bin/env python3
import json
import sys

entries = []
for line in sys.stdin:
    line = line.strip()
    if line:
        event = json.loads(line)
        entries.append((event.get("occurred_at", ""), (event.get("payload") or {}).get("text", "")))
for at, text in reversed(entries):
    print(f"{at}\t{text}")
