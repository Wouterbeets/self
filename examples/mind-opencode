#!/usr/bin/env python3
"""mind-opencode — SELF_MIND adapter backed by `opencode run`.

Two faces, same script:

  filter (the pipe):  echo hello | self | examples/mind-opencode | self
      stdin is the ask; no extra argv. Assistant text is printed as-is.

  spawn (think/learn): SELF_MIND=examples/mind-opencode self think "…"
      last argv is the prompt; stdin is the orientation brief.

OpenCode's `--format json` is its own event stream. This adapter unwraps the
assistant text so the kernel sees ordinary prose + event objects.

    export SELF_MIND="$PWD/examples/mind-opencode"
    export SELF_OPENCODE_AUTO=1          # non-interactive tool use
    export SELF_OPENCODE_MODEL=…         # optional
"""

import json
import os
import subprocess
import sys

def opencode_command():
    cmd = [os.environ.get("SELF_OPENCODE", "opencode"), "run", "--format", "json"]
    if os.environ.get("SELF_OPENCODE_PURE", "1") != "0":
        cmd.append("--pure")
    model = os.environ.get("SELF_OPENCODE_MODEL", "")
    if model:
        cmd.extend(["--model", model])
    agent = os.environ.get("SELF_OPENCODE_AGENT", "")
    if agent:
        cmd.extend(["--agent", agent])
    if os.environ.get("SELF_OPENCODE_AUTO", "") in ("1", "true", "yes"):
        cmd.append("--auto")
    return cmd


def run_opencode(message, brief):
    proc = subprocess.run(
        opencode_command() + [message],
        input=brief,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=os.environ.get("SELF_HOME") or None,
    )
    if proc.stderr:
        sys.stderr.write(proc.stderr)
    if proc.returncode != 0:
        raise SystemExit(proc.returncode)
    return collect_text(proc.stdout)


def collect_text(stream):
    chunks = []
    fallback = []
    for raw in stream.splitlines():
        if not raw.strip():
            continue
        try:
            obj = json.loads(raw)
        except json.JSONDecodeError:
            fallback.append(raw)
            continue
        part = obj.get("part") if isinstance(obj, dict) else None
        if isinstance(part, dict) and part.get("type") == "text":
            chunks.append(part.get("text", ""))
    if chunks:
        return "".join(chunks).strip()
    return "\n".join(fallback).strip()


def main():
    stdin = sys.stdin.read()
    # filter: spawned with no extra argv, ask on stdin.
    # spawn: last argv is the prompt, stdin is the brief.
    extra = sys.argv[1:]
    if extra:
        message, brief = extra[-1], stdin
    else:
        message, brief = stdin, ""
    if not message.strip():
        sys.stderr.write("mind-opencode: empty ask\n")
        raise SystemExit(1)
    print(run_opencode(message, brief))


if __name__ == "__main__":
    main()
