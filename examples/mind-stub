#!/usr/bin/env python3
"""mind-stub — a deterministic, offline mind. No LLM, no network, no state.

A mind is any filter: it reads a situated prompt on stdin and prints event JSONL
on stdout. This one is deliberately dumb — it proves the machinery, not the
intelligence — and it plugs into exactly the same seam as any real mind:

    self "hello"                     | examples/mind-stub | self hear
    self learn lessons/journal       | examples/mind-stub | self hear
    self                             | examples/mind-stub | self hear

What it does, reading the prompt alone (a real mind would also explore SELF_HOME
with its own tools):

  - Every pending declaration block is answered with a script.authored line
    carrying a trivial script that honors the capability contract.
  - An ask carrying an "--- INTENT" section (a learn) is answered with one
    command.declared and one view.declared, named from the intent's backticks,
    plus their scripts in the same pass.
  - Anything else gets silence, which is a valid turn.
"""

import json
import re
import sys


def backticked(s):
    return re.findall(r"`([^`]*)`", s)


def slug(s):
    out, dash = [], False
    for ch in s.strip().lower():
        if ch.isascii() and (ch.isalnum() or ch in "_-"):
            out.append(ch)
            dash = False
        elif not dash:
            out.append("-")
            dash = True
    return "".join(out).strip("-")


def first_command(intent):
    for tok in backticked(intent):
        if tok.startswith("self run "):
            rest = tok[len("self run "):].split()
            if rest:
                return slug(rest[0])
    return ""


def first_view(intent):
    for tok in backticked(intent):
        if tok.startswith("self view "):
            rest = tok[len("self view "):].split()
            if rest:
                return slug(rest[0])
    return ""


def first_event(intent):
    for tok in backticked(intent):
        if re.fullmatch(r"[a-z][a-z0-9_]*(\.[a-z0-9_]+)+", tok):
            return tok
    return ""


def emit(name, payload):
    print(json.dumps({"name": name, "payload": payload}))


def command_script(event_name):
    # stdin is the whole log and must be drained; argv is the arguments; stdout
    # is new events.
    return (
        "#!/usr/bin/env python3\n"
        "import sys, json\n"
        "sys.stdin.read()\n"
        "text = ' '.join(sys.argv[1:]).strip()\n"
        "if not text:\n"
        "    sys.exit('nothing to record')\n"
        "print(json.dumps({'name': %r, 'payload': {'text': text}}))\n" % event_name
    )


def view_script():
    # stdin is the consumed events as JSONL; stdout is opaque bytes.
    return (
        "#!/usr/bin/env python3\n"
        "import sys, json\n"
        "rows = []\n"
        "for line in sys.stdin:\n"
        "    line = line.strip()\n"
        "    if not line:\n"
        "        continue\n"
        "    e = json.loads(line)\n"
        "    p = e.get('payload') or {}\n"
        "    rows.append((e.get('occurred_at', ''), p.get('text', json.dumps(p))))\n"
        "for when, what in reversed(rows):\n"
        "    print('%s  %s' % (when, what))\n"
    )


def answer_pending(prompt):
    """Author every declaration the pending section lists."""
    found = False
    for typ, name in re.findall(r'^(command|view) "([^"]+)" declared at seq', prompt, re.M):
        script = command_script("stub." + slug(name).replace("-", "_")) if typ == "command" else view_script()
        emit("script.authored", {"type": typ, "name": name, "script": script})
        found = True
    return found


def answer_intent(prompt):
    """Realize an intent as one command and one view.

    The intent rides the prompt quoted line by line (it is another instance's
    prose), so unquote it before reading the names out of it.
    """
    body = prompt.split("--- INTENT", 1)[1].split("--- END INTENT", 1)[0]
    body = body.split("\n", 1)[1] if "\n" in body else body
    intent = "\n".join(
        line[2:] if line.startswith("| ") else line for line in body.split("\n")
    )
    command = first_command(intent) or "note"
    view = first_view(intent) or "notes"
    event = first_event(intent) or "stub.noted"

    emit("command.declared", {
        "name": command,
        "description": "stub: usage: %s <text…> — appends %s {text}" % (command, event),
    })
    emit("script.authored", {"type": "command", "name": command, "script": command_script(event)})
    emit("view.declared", {
        "name": view,
        "description": "stub: every %s, newest first" % event,
        "consumes": [event],
    })
    emit("script.authored", {"type": "view", "name": view, "script": view_script()})


def main():
    prompt = sys.stdin.read()
    if answer_pending(prompt):
        return
    if "--- INTENT" in prompt:
        answer_intent(prompt)
        return
    # Nothing to do. Silence is a valid turn.


if __name__ == "__main__":
    main()
