#!/usr/bin/env python3
"""history: search every earlier agent conversation on this machine.

usage: history search <words…> [--here | --lane DIR] [--src cc|oc|pi] [--role R]
                               [--since YYYY-MM-DD] [--recent] [-n N] [--raw]
       history show <id> [-C N] [--max BYTES]
       history sessions [--here | --lane DIR] [-n N]
       history index

Reads the transcripts the harnesses already keep (Claude Code and pi JSONL,
opencode's SQLite) into a full-text index. Nothing records turns, no hook runs,
no model is called: the index is derived and catches up on each use, reading
only what was appended since. Delete it and it rebuilds.
"""
import argparse
import json
import os
import re
import sqlite3
import sys
import time
from pathlib import Path

HOME = Path.home()
DB = Path(os.environ.get("SELF_HISTORY_DB", HOME / ".cache/self-history/index.db"))
CLAUDE = Path(os.environ.get("SELF_HISTORY_CLAUDE", HOME / ".claude/projects"))
PI = Path(os.environ.get("SELF_HISTORY_PI", HOME / ".pi/agent/sessions"))
OPENCODE = Path(os.environ.get("SELF_HISTORY_OPENCODE", HOME / ".local/share/opencode/opencode.db"))

# Tool output is most of the bytes and least of the meaning: index its head and
# tail. `show` reads the whole of it back from the source.
HEAD, TAIL, CALL = 8000, 2000, 2000

SCHEMA = """
CREATE TABLE IF NOT EXISTS file(path TEXT PRIMARY KEY, offset INTEGER, size INTEGER);
CREATE TABLE IF NOT EXISTS state(k TEXT PRIMARY KEY, v);
CREATE TABLE IF NOT EXISTS skip(id TEXT PRIMARY KEY);
CREATE TABLE IF NOT EXISTS session(src TEXT, id TEXT, lane TEXT, title TEXT, parent TEXT,
  first TEXT, last TEXT, PRIMARY KEY(src, id));
CREATE TABLE IF NOT EXISTS msg(id INTEGER PRIMARY KEY, key TEXT UNIQUE, file TEXT, src TEXT,
  session TEXT, lane TEXT, ts TEXT, n INTEGER, role TEXT, loc TEXT, text TEXT);
CREATE INDEX IF NOT EXISTS msg_session ON msg(src, session, ts, n);
CREATE INDEX IF NOT EXISTS msg_file ON msg(file);
CREATE VIRTUAL TABLE IF NOT EXISTS fts USING fts5(text, content='msg', content_rowid='id');
CREATE TRIGGER IF NOT EXISTS msg_ai AFTER INSERT ON msg BEGIN
  INSERT INTO fts(rowid, text) VALUES (new.id, new.text); END;
CREATE TRIGGER IF NOT EXISTS msg_ad AFTER DELETE ON msg BEGIN
  INSERT INTO fts(fts, rowid, text) VALUES ('delete', old.id, old.text); END;
"""


def clip(s, head=HEAD, tail=TAIL):
    if len(s) <= head + tail:
        return s
    return f"{s[:head]}\n…[{len(s) - head - tail} chars]…\n{s[-tail:]}"


def flat(content):
    """Text of a message content: a string, or a list of blocks."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    return ""


def call(name, args):
    return clip(f"{name} {json.dumps(args, ensure_ascii=False)}", CALL, 0)


# Each reader yields rows (n, block, ts, role, text, session, lane) for one
# parsed line; n is the line number, block the index within the line.

ECHO = re.compile(r"(^|[\s;&|(/\"'])history (search|show|sessions|index)\b")


def echo(db, cid, text):
    """A call to history itself, and so its result, would only find itself
    next time. Remember its id so the result is skipped too, even when it
    arrives in a later pass."""
    if ECHO.search(text or ""):
        db.execute("INSERT OR IGNORE INTO skip VALUES (?)", (cid,))
        return True
    return False


def skipped(db, cid):
    return db.execute("SELECT 1 FROM skip WHERE id=?", (cid,)).fetchone() is not None


def claude_rows(db, d):
    if d.get("type") not in ("user", "assistant") or d.get("isMeta"):
        return
    m = d.get("message") or {}
    content = m.get("content")
    blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
    for i, b in enumerate(blocks):
        t = b.get("type")
        if t == "text" and b.get("text", "").strip():
            yield i, d["type"], b["text"]
        elif t == "tool_use":
            text = call(b.get("name"), b.get("input"))
            if not echo(db, b.get("id"), text):
                yield i, "tool", text
        elif t == "tool_result" and not skipped(db, b.get("tool_use_id")):
            yield i, "result", clip(flat(b.get("content")))


def pi_rows(db, d):
    m = d.get("message") or {}
    role = m.get("role")
    if role == "toolResult" and skipped(db, m.get("toolCallId")):
        return
    for i, b in enumerate(m.get("content") or []):
        t = b.get("type")
        if role == "toolResult" and t == "text":
            yield i, "result", clip(b.get("text", ""))
        elif t == "text" and b.get("text", "").strip():
            yield i, role, b["text"]
        elif t == "toolCall":
            text = call(b.get("name"), b.get("arguments"))
            if not echo(db, b.get("id"), text):
                yield i, "tool", text


def index_jsonl(db, src, path, rows):
    """Index the complete lines appended to path since the last pass."""
    size = path.stat().st_size
    row = db.execute("SELECT offset, size FROM file WHERE path=?", (str(path),)).fetchone()
    offset = row[0] if row else 0
    if row and size < row[1]:  # rewritten, not appended
        db.execute("DELETE FROM msg WHERE file=?", (str(path),))
        offset = 0
    if offset >= size:
        return
    with open(path, "rb") as f:
        lineno = 0 if offset == 0 else db.execute(
            "SELECT v FROM state WHERE k=?", ("lines:" + str(path),)).fetchone()[0]
        f.seek(offset)
        data = f.read()
    end = data.rfind(b"\n") + 1
    session = lane = None
    if src == "pi" and offset:
        session, lane = db.execute(
            "SELECT session, lane FROM msg WHERE file=? LIMIT 1", (str(path),)).fetchone() or (None, None)
    for line in data[:end].splitlines():
        lineno += 1
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if src == "pi" and d.get("type") == "session":
            session, lane = d.get("id"), d.get("cwd")
            continue
        if src == "cc":
            session, lane = d.get("sessionId", session), d.get("cwd", lane)
            if "/subagents/" in str(path):  # a subagent is its own session under its parent's
                session = f"{session}/{path.stem}"
        ts = d.get("timestamp", "")
        for i, role, text in rows(db, d):
            db.execute(
                "INSERT OR IGNORE INTO msg(key, file, src, session, lane, ts, n, role, loc, text)"
                " VALUES (?,?,?,?,?,?,?,?,?,?)",
                (f"{path}:{lineno}:{i}", str(path), src, session, lane, ts, lineno * 100 + i, role,
                 f"{path}:{lineno}:{i}", text))
            touch(db, src, session, lane, ts, text if role == "user" else None)
    db.execute("INSERT OR REPLACE INTO file VALUES (?,?,?)", (str(path), offset + end, size))
    db.execute("INSERT OR REPLACE INTO state VALUES (?,?)", ("lines:" + str(path), lineno))


def touch(db, src, session, lane, ts, prompt=None, title=None, parent=None):
    if not session:
        return
    db.execute(
        "INSERT INTO session(src, id, lane, title, parent, first, last) VALUES (?,?,?,?,?,?,?)"
        " ON CONFLICT(src, id) DO UPDATE SET last=max(last, excluded.last),"
        " lane=coalesce(session.lane, excluded.lane), title=coalesce(session.title, excluded.title)",
        (src, session, lane, title or (prompt[:200] if prompt else None), parent, ts, ts))


def iso(ms):
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(ms / 1000)) + f".{ms % 1000:03d}Z"


def index_opencode(db):
    if not OPENCODE.exists():
        return
    since = (db.execute("SELECT v FROM state WHERE k='opencode'").fetchone() or (0,))[0]
    oc = sqlite3.connect(f"file:{OPENCODE}?mode=ro", uri=True, timeout=10)
    for sid, parent, lane, title, created, updated in oc.execute(
            "SELECT id, parent_id, directory, title, time_created, time_updated FROM session"
            " WHERE time_updated > ?", (since,)):
        touch(db, "oc", sid, lane, iso(created), title=title, parent=parent)
        touch(db, "oc", sid, lane, iso(updated))
    top = since
    for pid, sid, created, updated, mdata, pdata, lane in oc.execute(
            "SELECT p.id, p.session_id, p.time_created, p.time_updated, m.data, p.data, s.directory"
            " FROM part p JOIN message m ON m.id = p.message_id JOIN session s ON s.id = p.session_id"
            " WHERE p.time_updated > ? ORDER BY p.time_updated", (since,)):
        top = max(top, updated)
        p, role = json.loads(pdata), json.loads(mdata).get("role")
        rows = []
        if p.get("type") == "text" and p.get("text", "").strip() and not p.get("synthetic"):
            rows.append((role, p["text"]))
        elif p.get("type") == "tool":
            st = p.get("state") or {}
            text = call(p.get("tool"), st.get("input"))
            if ECHO.search(text):
                continue
            rows.append(("tool", text))
            if st.get("status") in ("completed", "error"):
                rows.append(("result", clip(str(st.get("output") or st.get("error") or ""))))
        db.execute("DELETE FROM msg WHERE file=?", ("oc:" + pid,))
        for i, (r, text) in enumerate(rows):
            db.execute(
                "INSERT INTO msg(key, file, src, session, lane, ts, n, role, loc, text)"
                " VALUES (?,?,?,?,?,?,?,?,?,?)",
                (f"oc:{pid}:{i}", "oc:" + pid, "oc", sid, lane, iso(created), i, r, f"opencode part {pid}:{i}", text))
    db.execute("INSERT OR REPLACE INTO state VALUES ('opencode', ?)", (top,))


def open_index():
    DB.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(DB, timeout=60)
    db.executescript(SCHEMA)
    return db


def refresh(db):
    for src, root, rows, pattern in (("cc", CLAUDE, claude_rows, "**/*.jsonl"), ("pi", PI, pi_rows, "*/*.jsonl")):
        if root.exists():
            for path in sorted(root.glob(pattern)):
                with db:
                    index_jsonl(db, src, path, rows)
    with db:
        index_opencode(db)


def fts_query(words, raw):
    if raw:
        return " ".join(words)
    return " ".join('"' + w.replace('"', '""') + '"' for w in words)


def short(lane):
    return lane.replace(str(HOME), "~", 1) if lane else "?"


def where(a, t=""):
    """Filters shared by search and sessions; t prefixes the column names."""
    sql, args = [], []
    lane = os.getcwd() if a.here else a.lane
    if lane:
        sql.append(f"({t}lane = ? OR {t}lane LIKE ?)")
        args += [lane, lane.rstrip("/") + "/%"]
    for col, v in (("src", getattr(a, "src", None)), ("role", getattr(a, "role", None))):
        if v:
            sql.append(f"{t}{col} = ?")
            args.append(v)
    if getattr(a, "since", None):
        sql.append(f"{t}ts >= ?")
        args.append(a.since)
    return sql, args


def search(db, a):
    sql, args = where(a, "m.")
    # The caller's own session is already in its context.
    for var in ("CLAUDE_CODE_SESSION_ID", "SELF_HISTORY_SESSION"):
        if os.environ.get(var):
            sql.append("m.session NOT LIKE ?")
            args.append(os.environ[var] + "%")
    sql = " AND ".join(["fts MATCH ?"] + sql)
    order = "m.ts DESC" if a.recent else "bm25(fts)"
    rows = db.execute(
        f"SELECT m.id, m.src, m.session, m.lane, m.ts, m.role, snippet(fts, 0, '[', ']', '…', 24)"
        f" FROM fts JOIN msg m ON m.id = fts.rowid WHERE {sql} ORDER BY {order} LIMIT ?",
        [fts_query(a.words, a.raw)] + args + [a.n]).fetchall()
    if not rows:
        print("history: no match; try fewer or other words, or --raw for FTS5 syntax (OR, NEAR, prefix*)")
    for mid, src, session, lane, ts, role, snip in rows:
        snip = " ".join(snip.split())
        print(f"{mid}\t{ts[:16].replace('T', ' ')}\t{src}:{(session or '?')[:12]}\t{short(lane)}\t{role}: {snip}")
    if rows:
        print(f"\nhistory show <id> for the surrounding turns; the first column is the id.")


def source(loc):
    """The full, unclipped text of one message, read back from its transcript."""
    if loc.startswith("opencode part "):
        pid, i = loc[len("opencode part "):].rsplit(":", 1)
        oc = sqlite3.connect(f"file:{OPENCODE}?mode=ro", uri=True)
        p = json.loads(oc.execute("SELECT data FROM part WHERE id=?", (pid,)).fetchone()[0])
        if p.get("type") == "text":
            return p.get("text", "")
        st = p.get("state") or {}
        if i == "0":
            return f"{p.get('tool')} {json.dumps(st.get('input'), ensure_ascii=False, indent=1)}"
        return str(st.get("output") or st.get("error") or "")
    path, lineno, i = loc.rsplit(":", 2)
    with open(path, "rb") as f:
        for k, line in enumerate(f, 1):
            if k == int(lineno):
                break
    d = json.loads(line)
    content = (d.get("message") or {}).get("content")
    if isinstance(content, str):
        return content
    b = content[int(i)]
    if b.get("type") in ("tool_use", "toolCall"):
        return f"{b.get('name')} {json.dumps(b.get('input', b.get('arguments')), ensure_ascii=False, indent=1)}"
    if b.get("type") == "tool_result":
        return flat(b.get("content"))
    return b.get("text", "")


def show(db, a):
    row = db.execute("SELECT src, session, lane, ts, n, role, loc FROM msg WHERE id=?", (a.id,)).fetchone()
    if not row:
        sys.exit(f"history: no message {a.id}; ids come from history search")
    src, session, lane, ts, n, role, loc = row
    title = db.execute("SELECT title FROM session WHERE src=? AND id=?", (src, session)).fetchone()
    print(f"# {src}:{session} in {short(lane)}" + (f" — {' '.join(title[0].split())[:120]}" if title and title[0] else ""))
    before = db.execute("SELECT id, ts, role, text FROM msg WHERE src=? AND session=? AND (ts, n) < (?, ?)"
                        " ORDER BY ts DESC, n DESC LIMIT ?", (src, session, ts, n, a.C)).fetchall()[::-1]
    after = db.execute("SELECT id, ts, role, text FROM msg WHERE src=? AND session=? AND (ts, n) > (?, ?)"
                       " ORDER BY ts, n LIMIT ?", (src, session, ts, n, a.C)).fetchall()
    for mid, t, r, text in before:
        print(f"\n## {mid} {t[:19]} {r}\n{clip(text, 600, 200)}")
    try:
        full = source(loc)
    except (OSError, ValueError, TypeError, IndexError, StopIteration):
        full = db.execute("SELECT text FROM msg WHERE id=?", (a.id,)).fetchone()[0] + "\n(source gone; indexed text)"
    print(f"\n## {a.id} {ts[:19]} {role}  ◀ ({loc})\n{clip(full, a.max, 0)}")
    for mid, t, r, text in after:
        print(f"\n## {mid} {t[:19]} {r}\n{clip(text, 600, 200)}")


def sessions(db, a):
    sql, args = where(a)
    rows = db.execute(
        f"SELECT src, id, lane, last, title FROM session {'WHERE ' + ' AND '.join(sql) if sql else ''}"
        f" ORDER BY last DESC LIMIT ?", args + [a.n]).fetchall()
    for src, sid, lane, last, title in rows:
        print(f"{(last or '')[:16].replace('T', ' ')}\t{src}:{sid[:12]}\t{short(lane)}\t{' '.join((title or '').split())[:100]}")


def main():
    p = argparse.ArgumentParser(prog="history", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("search", help="find messages by words; identifiers match exactly")
    s.add_argument("words", nargs="+")
    s.add_argument("--recent", action="store_true", help="newest first instead of best match")
    s.add_argument("--raw", action="store_true", help="pass words as an FTS5 query")
    s.add_argument("--role", choices=["user", "assistant", "tool", "result"])
    s.add_argument("--since", help="YYYY-MM-DD")
    for q in (s, sub.add_parser("sessions", help="recent sessions, newest first")):
        q.add_argument("--here", action="store_true", help="only this directory and below")
        q.add_argument("--lane", help="only this directory and below")
        q.add_argument("--src", choices=["cc", "oc", "pi"], help="Claude Code, opencode, pi")
        q.add_argument("-n", type=int, default=15)
    w = sub.add_parser("show", help="one message in full, with its neighbours")
    w.add_argument("id", type=int)
    w.add_argument("-C", type=int, default=3, help="neighbours on each side")
    w.add_argument("--max", type=int, default=20000, help="bytes of the message itself")
    sub.add_parser("index", help="catch the index up and report its size")
    a = p.parse_args()
    db = open_index()
    refresh(db)
    if a.cmd == "search":
        search(db, a)
    elif a.cmd == "show":
        show(db, a)
    elif a.cmd == "sessions":
        sessions(db, a)
    else:
        n, = db.execute("SELECT count(*) FROM msg").fetchone()
        print(f"history: {n} messages in {DB} ({DB.stat().st_size >> 20} MB)")


if __name__ == "__main__":
    main()
