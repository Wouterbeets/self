#!/usr/bin/env python3
"""mind-claude — `claude -p` as a mind, with a live trace on stderr.

A mind reads a situated prompt on stdin and prints event JSONL on stdout, and
`self loop` buffers that stdout until the process exits — so a plain `claude -p`
is silent for the whole waking and you learn what it did only when it is over.
This wrapper asks claude for its stream-json trace instead, renders every text
block, tool call and tool result to stderr as they happen, and forwards only
the event-shaped lines of the final answer to stdout. The loop already routes mind stderr to the terminal, so:

    self loop --ask "…" -- examples/mind-claude

Anything after the script name is passed to claude verbatim; when nothing grants
tools, Bash Read Write Edit Glob Grep are allowed, because a mind with no tools
spends its waking being denied. The wire is unchanged: what claude would have
printed as its answer is exactly what lands on stdout, one waking's worth.
"""

import json
import os
import subprocess
import sys

DIM, BOLD, RESET = "\033[2m", "\033[1m", "\033[0m"
if not sys.stderr.isatty():
    DIM = BOLD = RESET = ""

# Tool result text is bounded so a `cat events.jsonl` does not flood the trace.
RESULT_CAP = int(os.environ.get("MIND_CLAUDE_RESULT_CAP", "600"))


def say(line):
    sys.stderr.write(line + "\n")
    sys.stderr.flush()


def one_line(value, cap):
    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
    text = " ".join(text.split())
    return text if len(text) <= cap else text[: cap - 1] + "…"


def describe_tool(name, inp):
    if not isinstance(inp, dict):
        return one_line(inp, 200)
    for key in ("command", "file_path", "pattern", "query", "description"):
        if key in inp:
            return one_line(inp[key], 240)
    return one_line(inp, 200)


def block_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"
        )
    return ""


def render(event):
    kind = event.get("type")
    if kind == "system" and event.get("subtype") == "init":
        say(f"{DIM}mind-claude: model {event.get('model', '?')} · session {event.get('session_id', '?')}{RESET}")
        return
    if kind == "assistant":
        for block in event.get("message", {}).get("content", []):
            if not isinstance(block, dict):
                continue
            if block.get("type") == "text" and block.get("text", "").strip():
                for line in block["text"].strip().splitlines():
                    say(f"  {line}")
            elif block.get("type") == "tool_use":
                say(f"{BOLD}▸ {block.get('name', 'tool')}{RESET} {describe_tool(block.get('name'), block.get('input'))}")
        return
    if kind == "user":
        for block in event.get("message", {}).get("content", []):
            if isinstance(block, dict) and block.get("type") == "tool_result":
                text = block_text(block.get("content"))
                flag = " (error)" if block.get("is_error") else ""
                say(f"{DIM}  ↳{flag} {one_line(text, RESULT_CAP)}{RESET}")
        return
    if kind == "result":
        cost = event.get("total_cost_usd")
        turns = event.get("num_turns")
        detail = []
        if turns is not None:
            detail.append(f"{turns} turn(s)")
        if cost is not None:
            detail.append(f"${cost:.4f}")
        if event.get("subtype") not in (None, "success"):
            detail.append(str(event.get("subtype")))
        say(f"{DIM}mind-claude: done · {' · '.join(detail)}{RESET}")


# A mind is expected to have tools; `claude -p` has none unless told. When the
# caller grants nothing, grant the ordinary set, so a bare invocation is a
# working mind rather than a waking spent being denied.
DEFAULT_TOOLS = ["--allowedTools", "Bash", "Read", "Write", "Edit", "Glob", "Grep"]
GRANTS = ("--allowedTools", "--allowed-tools", "--permission-mode", "--dangerously-skip-permissions")


def main():
    prompt = sys.stdin.read()
    extra = list(sys.argv[1:])
    if not any(a.split("=")[0] in GRANTS for a in extra):
        extra = DEFAULT_TOOLS + extra
    # The loop pins SELF_HOME into this environment. Name it, because a shell
    # that exports SELF_HOME globally will wake that body, not the cwd — and a
    # nudge meant for a scratch instance landing on a real one is worth seeing
    # before the first tool call, not after.
    say(f"{DIM}mind-claude: body {os.environ.get('SELF_HOME') or os.getcwd()}{RESET}")
    argv = ["claude", "-p", "--output-format", "stream-json", "--verbose", *extra]
    env = dict(os.environ)
    # A claude started from inside another claude session refuses to nest.
    env.pop("CLAUDECODE", None)
    env.pop("CLAUDE_CODE_ENTRYPOINT", None)
    proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env=env)
    proc.stdin.write(prompt)
    proc.stdin.close()

    answer = None
    for raw in proc.stdout:
        raw = raw.strip()
        if not raw:
            continue
        try:
            event = json.loads(raw)
        except ValueError:
            # Not a trace line: pass it through as if claude had printed it plain.
            say(f"{DIM}  ? {one_line(raw, 200)}{RESET}")
            continue
        render(event)
        if event.get("type") == "result":
            answer = event.get("result")
    code = proc.wait()
    # Only event-shaped lines reach the wire. The prose is already in the trace,
    # and forwarding it too made `hear` echo it a second time as pass-through.
    if isinstance(answer, str):
        for line in answer.splitlines():
            candidate = line.strip().strip("`").strip()
            try:
                obj = json.loads(candidate)
            except ValueError:
                continue
            if isinstance(obj, dict) and isinstance(obj.get("name"), str) and "payload" in obj:
                sys.stdout.write(candidate + "\n")
        sys.stdout.flush()
    sys.exit(code)


if __name__ == "__main__":
    main()
