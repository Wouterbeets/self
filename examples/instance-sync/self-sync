#!/bin/sh
# One convergence tick for this body: both directions, every live peer.
#
# Nothing here knows the domain. The roster comes from the log (peers --names),
# and each direction is a capability that appends only when something actually
# moved — so a quiet tick is one round trip per peer and no writes at all.
#
# A peer that is asleep makes ssh fail, this exits non-zero, and nothing was
# appended: accounts are all-or-nothing on learn, so there is no half state to
# repair. The next tick simply tries again.
set -eu

export SELF_HOME="${SELF_HOME:-$HOME/.self}"
export SELF_CALLER="${SELF_CALLER:-self-sync timer}"
export SELF_SYNC_BIN="${SELF_SYNC_BIN:-$HOME/go/bin/self}"
export SELF_SYNC_TIMEOUT="${SELF_SYNC_TIMEOUT:-300}"

status=0
for peer in $("$SELF_SYNC_BIN" view peers --names); do
    "$SELF_SYNC_BIN" run sync.pull "$peer" || status=1
    "$SELF_SYNC_BIN" run sync.push "$peer" || status=1
done
exit "$status"
